# Defaults mirror docker-compose.yml — the compose file is the source of truth.
# Copy this file to .env and edit; compose only reads it, it is never committed.

# Port the app is exposed on (http://localhost:8020)
APP_PORT=8020

# LLM proxy (OpenAI-compatible endpoint). AI features are on only when
# LLM_TIER=on AND LLM_API_KEY is set; otherwise manual entry and
# deterministic parsing still work.
LLM_BASE_URL=http://host.docker.internal:11444
LLM_API_KEY=
LLM_TIER=off

# Optional extraction approval threshold
APPROVAL_THRESHOLD=

# Database connection string (points at the compose `db` service)
DATABASE_URL=postgresql+psycopg://lio:lio@db:5432/lio

# Accounts seeded on boot (LOGIN_ARCHITECTURE.md) — display_name:email:role[:password],
# comma-separated. Default below mirrors docker-compose.yml; password defaults
# to `demo`. No signup — admin manages accounts (out of scope for now).
#SEED_USERS=Ana Weber:ana@example.com:requestor,Tom Richter:tom@example.com:requestor,Kim Schneider:kim@example.com:procurement,Sam Admin:admin@example.com:admin

# Session lifetime in seconds (sliding idle expiry; hard cap via SESSION_ABS_TTL)
SESSION_IDLE_TTL=43200

# Host port for the db service (host-run pytest needs it; unset keeps 5432)
DB_PORT=