# Copy to .env and adjust. Without a key, the app runs with AI features off
# (manual entry and deterministic parsing still work).
LLM_API_KEY=
LLM_BASE_URL=http://host.docker.internal:11444
LLM_TIER=off
# Optional override; compose defaults to the `db` service:
# DATABASE_URL=postgresql+psycopg://lio:lio@db:5432/lio
# APP_PORT=8020
# APPROVAL_THRESHOLD=